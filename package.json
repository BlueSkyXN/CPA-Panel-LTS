{
  "name": "cli-proxy-webui-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,scss}\"",
    "type-check": "tsc --noEmit",
    "test:usage-cache": "node --test src/utils/usage/cacheTokens.test.mjs",
    "test:usage-prices": "node --test src/utils/usage/modelPrices.test.mjs",
    "test:usage-import": "node --test src/utils/usage/importPreflight.test.mjs",
    "test:usage-effort": "node --test src/utils/usage/reasoningEffort.test.mjs",
    "test:usage-tier": "node --test src/utils/usage/serviceTier.test.mjs",
    "test:usage-performance": "node --test src/utils/usage/performance.test.mjs",
    "test:usage-pricing-v3": "node --test src/utils/usage/pricing/index.test.mjs",
    "test:usage-pricing-catalog": "node --test src/components/usage/PresetPricingCatalog.test.mjs",
    "test:usage-pricing-storage": "node --test src/utils/usage/pricing/storage.test.mjs",
    "test:usage-pricing-integration": "node --test src/utils/usage/pricing/usagePricing.test.mjs src/utils/usage/pricing/usageAggregation.test.mjs src/components/usage/RequestEventsDetailsCard.test.mjs",
    "test:dashboard": "node --test src/features/dashboard/dashboardMetrics.test.mjs",
    "test:config": "node --test src/components/config/apiKeySecurity.test.mjs && npm run test:flow-control",
    "test:provider-xai": "node --test src/features/providers/xaiApiKeyProvider.test.mjs",
    "test:provider-integrity": "node --test src/features/providers/providerIntegrity.test.mjs",
    "test:provider-recent": "node --test src/components/providers/hooks/providerRecentRequests.test.mjs",
    "test:providers": "npm run test:provider-xai && npm run test:provider-integrity && npm run test:provider-recent",
    "test:plugins": "node --test src/features/plugins/pluginResources.test.mjs",
    "test:auth-files": "node --test src/features/authFiles/oauthConfigLoadGuard.test.mjs src/utils/quota/upstreamQuotaPort.test.mjs",
    "test:codex-remote": "node --test src/lts/codexRemoteCloudConnect/viewModel.test.mjs",
    "test:quota": "node --test src/utils/quota/upstreamQuotaPort.test.mjs",
    "test:api-client": "node --test src/services/api/client.test.mjs",
    "test:logs": "node --test src/utils/logLines.test.mjs",
    "test:ui": "node --test src/components/ui/Collapsible/Collapsible.test.mjs src/stores/themeWorkspace.test.mjs",
    "test:usage": "npm run test:usage-cache && npm run test:usage-prices && npm run test:usage-import && npm run test:usage-effort && npm run test:usage-tier && npm run test:usage-performance && npm run test:usage-pricing-v3 && npm run test:usage-pricing-catalog && npm run test:usage-pricing-storage && npm run test:usage-pricing-integration",
    "check:feature-contract": "node scripts/check-panel-feature-contracts.mjs",
    "check:lts": "scripts/check-lts-panel-contract.sh",
    "validate:lts": "npm run test:usage && npm run test:dashboard && npm run test:config && npm run test:providers && npm run test:plugins && npm run test:auth-files && npm run test:codex-remote && npm run test:api-client && npm run test:logs && npm run test:ui && npm run check:lts && npm run type-check && npm run lint && npm run build",
    "smoke:lts": "npm run build && python3 scripts/smoke-lts-panel.py",
    "smoke:lts:core": "npm run build && python3 scripts/smoke-lts-panel-core.py",
    "test:flow-control": "node --test src/lts/flowControl/*.test.mjs"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/merge": "^6.12.0",
    "@uiw/react-codemirror": "^4.25.3",
    "axios": "^1.18.1",
    "chart.js": "^4.5.1",
    "i18next": "^25.7.1",
    "motion": "^12.34.3",
    "react": "^19.2.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.1",
    "react-i18next": "^16.4.0",
    "react-router-dom": "^7.18.1",
    "yaml": "^2.9.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "sass": "^1.94.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
